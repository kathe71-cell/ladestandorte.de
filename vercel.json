{
  "buildCommand": "npm run build:ci",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/rechner-embed",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *;"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/betreiber/tesla",
      "destination": "/betreiber/tesla-supercharger",
      "permanent": true
    },
    {
      "source": "/mcs/hub/aral-pulse-schwarmstedt-a7",
      "destination": "/mcs/hub/aral-pulse-lkw-megawatt-hub-schwarmstedt",
      "permanent": true
    },
    {
      "source": "/ladestation/frankfurt/ionity-raststaette-spessart-sued",
      "destination": "/ladestation/rohrbrunn/ionity-raststaette-spessart-sued",
      "permanent": true
    },
    {
      "source": "/ladestation/augsburg/sortimo-innovationspark-zusmarshausen",
      "destination": "/ladestation/zusmarshausen/sortimo-innovationspark-zusmarshausen",
      "permanent": true
    },
    {
      "source": "/ladestation/stuttgart/enbw-hyperhub-rutesheim",
      "destination": "/ladestation/rutesheim/enbw-hyperhub-rutesheim",
      "permanent": true
    },
    {
      "source": "/ladestation/duesseldorf/seed-und-greet-ladepark-kreuz-hilden",
      "destination": "/ladestation/hilden/seed-und-greet-ladepark-kreuz-hilden",
      "permanent": true
    },
    {
      "source": "/ladestation/dortmund/enbw-hyperhub-kamener-kreuz",
      "destination": "/ladestation/kamen/enbw-hyperhub-kamener-kreuz",
      "permanent": true
    },
    {
      "source": "/ladestation/chemnitz/enbw-hyperhub-meerane",
      "destination": "/ladestation/meerane/enbw-hyperhub-meerane",
      "permanent": true
    },
    {
      "source": "/ladestation/bonn/ionity-raststaette-brohltal-ost",
      "destination": "/ladestation/niederzissen/ionity-raststaette-brohltal-ost",
      "permanent": true
    },
    {
      "source": "/ladestation/kassel/fastned-autohof-muecke",
      "destination": "/ladestation/muecke/fastned-autohof-muecke",
      "permanent": true
    },
    {
      "source": "/ladestation/nuernberg/enbw-hyperhub-geiselwind",
      "destination": "/ladestation/geiselwind/enbw-hyperhub-geiselwind",
      "permanent": true
    },
    {
      "source": "/ladestation/hamburg/tesla-supercharger-braak",
      "destination": "/ladestation/braak/tesla-supercharger-braak",
      "permanent": true
    },
    {
      "source": "/ladestation/regensburg/enbw-hyperhub-woerth-an-der-donau",
      "destination": "/ladestation/woerth-an-der-donau/enbw-hyperhub-woerth-an-der-donau",
      "permanent": true
    },
    {
      "source": "/ladestation/leipzig/ionity-raststaette-koeckern-west",
      "destination": "/ladestation/sandersdorf-brehna/ionity-raststaette-koeckern-west",
      "permanent": true
    },
    {
      "source": "/ladestation/leipzig/fastned-autohof-nempitz",
      "destination": "/ladestation/bad-duerrenberg/fastned-autohof-nempitz",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "ladestandorte.de"
        }
      ],
      "destination": "https://www.ladestandorte.de/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/mcs/hub/((?!aral-pulse-lkw-megawatt-hub-schwarmstedt|aral-pulse-lkw-megawatt-hub-schnaittach|aral-pulse-lkw-megawatt-hub-rastow|aral-pulse-lkw-megawatt-hub-koenigs-wusterhausen|hola-forschungskorridor-raststaette-lipperland-sued|hola-forschungskorridor-lehre-wendhausen|milence-lkw-ladehub-hermsdorfer-kreuz|milence-lkw-ladehub-kassel-lohfelden).*)",
      "destination": "/api/mcs-hub-handler?slug=$1"
    },
    {
      "source": "/ladestation-register/([^/]+)/([^/]+)",
      "destination": "/api/register-station-handler?city=$1&id=$2"
    },
    {
      "source": "/((?!ads\\.txt|robots\\.txt|sitemap\\.xml|feed\\.xml|llms\\.txt|og-image\\.png|favicon\\.svg|assets/.*).*)",
      "destination": "/index.html"
    }
  ],
  "cleanUrls": false,
  "trailingSlash": false
}